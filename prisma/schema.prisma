generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  STARTER
  PRO
}

model Tipster {
  id           String   @id
  email        String   @unique
  passwordHash String
  planTier     PlanTier @default(STARTER)
  trialEndsAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tipsters")
}
